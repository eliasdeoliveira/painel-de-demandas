# Copie para .env e ajuste conforme o ambiente.
# Nenhum destes valores é segredo: são apenas os padrões de desenvolvimento.
# A URL real de produção entra pelas variáveis de ambiente do provedor.

# Sem esta variável a aplicação usa SQLite em arquivo, sem exigir nenhum
# serviço. Para PostgreSQL, use o formato abaixo — o esquema `postgresql://`
# é aceito e traduzido para o driver correto:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_URL=sqlite:///./zeeway.db

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Opcional, só para testes: aponta a suíte para outro banco. Sem esta variável
# os testes rodam em SQLite em memória.
# TEST_DATABASE_URL=postgresql://usuario:senha@host:5432/banco
